---
import Layout from '../layouts/Layout.astro';
import { accreditations, trustStats, CANONICAL_URL } from '../data/site';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",  "item": CANONICAL_URL },
    { "@type": "ListItem", "position": 2, "name": "About", "item": `${CANONICAL_URL}/about` }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What accreditations does S.C Roofing hold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "S.C Roofing Ltd is a Trade Member of the National Federation of Roofing Contractors (NFRC), is registered under the NFRC Competent Person Scheme for pitched roofing self-certification (Certificate ID 11921, valid 10 May 2026 to 09 May 2027), and is a Velux Certified Installer under the TrustMark Government Endorsed Quality scheme. We are also fully insured for Public Liability and Employer's Liability, and registered in England & Wales."
      }
    },
    {
      "@type": "Question",
      "name": "What does the NFRC Competent Person Scheme mean for customers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NFRC CPS is the only roofing-specific scheme that allows roofers in England and Wales to self-certify that their roof refurbishment work meets Building Regulations 4 and 7. For the customer this means no separate Building Control inspection fee or delay on a qualifying re-roof, automatic issue of a Building Regulation Compliance Certificate, and eligibility for a 10-year Insurance-Backed Guarantee where required. S.C Roofing's CPS registration covers pitched roofing."
      }
    },
    {
      "@type": "Question",
      "name": "How long has S.C Roofing been trading?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "S.C Roofing Ltd has been trading for over 20 years, established in 2004. The company is based at Delys, Eckweek Road, Peasedown St John, Bath, BA2 8EQ and is privately owned."
      }
    },
    {
      "@type": "Question",
      "name": "What areas does S.C Roofing cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "S.C Roofing covers Bath, Somerset and north Wiltshire within a 30-mile radius of our Peasedown St John depot. This includes Bath itself, Keynsham, Radstock, Midsomer Norton, Frome, Trowbridge, Shepton Mallet, Wells, Paulton, Norton St Philip and surrounding villages."
      }
    },
    {
      "@type": "Question",
      "name": "Do you do free surveys?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. S.C Roofing provides free written surveys with no obligation and no hard sell. For most areas we can inspect within 24–48 hours of enquiry, and quotes are provided in writing before any work starts."
      }
    },
    {
      "@type": "Question",
      "name": "Does S.C Roofing do insurance work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. S.C Roofing accepts roofing work on insurance claims and provides written inspection reports suitable for use by insurers, loss adjusters, mortgage lenders and solicitors. We have over 20 years of experience with storm damage, leak investigations and pre-purchase roof surveys."
      }
    }
  ]
};
---

  <Layout
    title="About SC Roofing Ltd | Bath & Somerset Roofers"
    description="SC Roofing Ltd — a small, privately owned roofing company based in Peasedown St John, Bath. Over 20 years of experience. NFRC Trade Member, NFRC CPS registered for pitched roofing, Velux certified. Fully insured."
    canonicalPath="/about"
  schemas={[breadcrumbSchema, faqSchema]}
>

  <section class="relative bg-ink overflow-hidden flex flex-col justify-end" style="min-height: clamp(500px, 65vh, 700px);">
    <div class="absolute inset-0" aria-hidden="true">
      <img src="/images/roof-bristol.webp" alt="" class="w-full h-full object-cover object-center" loading="eager" />
      <div class="absolute inset-0 bg-ink/75"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink to-transparent"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 w-full pt-36 pb-16 lg:pb-24">
      <div class="flex items-center gap-3 mb-8">
        <span class="w-8 h-px bg-red block"></span>
        <span class="text-stone text-xs font-medium tracking-[0.25em] uppercase">About Us</span>
      </div>
      <h1 class="font-bebas text-white mb-6 leading-none" style="font-size: clamp(4rem, 10vw, 9rem); letter-spacing: 0.02em;">
        Built on<br /><span class="text-red">reputation.</span>
      </h1>
      <p class="text-stone text-xl max-w-2xl leading-relaxed">Small enough to care. Experienced enough to handle anything. Twenty years of doing it properly.</p>
    </div>
  </section>

  <!-- Big quote -->
  <section class="bg-ink border-t border-white/8 py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">
      <p class="font-display text-white/10 text-8xl leading-none -mb-6 select-none" aria-hidden="true">"</p>
      <blockquote class="font-display text-white italic leading-tight mb-8" style="font-size: clamp(1.75rem, 3.5vw, 3rem);">
        We've been fixing Bath's roofs for over 20 years. We're not the cheapest. We're the ones you call back.
      </blockquote>
      <cite class="text-stone text-sm not-italic tracking-wide">— S.C Roofing Ltd, est. 2004</cite>
    </div>
  </section>

  <!-- Story + photo -->
  <section class="bg-cream py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-display text-ink text-3xl font-bold mb-6">Who we are</h2>
        <div class="space-y-4 text-ink/65 leading-relaxed mb-10">
          <p>S.C Roofing Ltd is a small, privately owned roofing contractor based in Peasedown St John, Bath. We cover Bath, Somerset and north Wiltshire, working on everything from single-tile repairs to full commercial re-roofing projects.</p>
          <p>We've been in business for over 20 years. In that time we've built our reputation on three things: honest advice, quality workmanship, and a tidy finish. We don't oversell. If a repair will do the job, we'll say so.</p>
          <p>We work with homeowners, private landlords, letting agents, architects, building contractors and insurance companies.</p>
        </div>

        <h2 class="font-display text-ink text-3xl font-bold mb-6">Credentials</h2>
        <ul class="space-y-3 mb-10">
          {[
            'NFRC Member — Trade Member of the National Federation of Roofing Contractors',
            'NFRC Competent Person Scheme — registered for pitched roofing self-certification (ID 11921)',
            'Velux Certified Installer — TrustMark Government Endorsed Quality',
            'Fully insured — Public Liability & Employer\'s',
            'Registered in England & Wales',
            'Insurance work accepted — written reports provided',
            'Free surveys — no hard sell',
          ].map(c => (
            <li class="flex items-center gap-3 border-b border-ink/8 pb-3">
              <span class="w-5 h-5 bg-red rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span class="text-ink/80 text-sm">{c}</span>
            </li>
          ))}
        </ul>

        <!-- Accreditations note + current NFRC CPS cert -->
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ink/40 mb-4">NFRC Competent Person Scheme</p>
        <div class="border border-ink/10 bg-white p-3 mb-3 max-w-md">
          <img src="/images/nfrc-cps-2026.webp" alt="NFRC Competent Person Scheme certificate — SC Roofing Limited. Valid 10 May 2026 – 09 May 2027. Registered for pitched roofing self-certification."
            class="w-full h-auto" loading="lazy" width="900" height="1158" />
        </div>
        <p class="text-xs text-ink/50 leading-relaxed max-w-md mb-8">
          Certificate ID 11921 · Valid 10 May 2026 – 09 May 2027 · UKAS Product Certification 7717
        </p>

        <!-- Velux Certified Installer badge -->
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ink/40 mb-4">Velux Certified Installer</p>
        <div class="border border-ink/10 bg-white p-3 mb-3 max-w-md flex items-center gap-4">
          <img src="/images/velux-certified-2026.webp" alt="Velux Certified Installer badge — TrustMark Government Endorsed Quality"
            class="h-32 w-auto" loading="lazy" width="248" height="279" />
          <p class="text-xs text-ink/60 leading-relaxed flex-1">
            SC Roofing is registered as a Velux Certified Installer. Velux certification is part of the TrustMark Government Endorsed Quality scheme.
          </p>
        </div>
      </div>

      <!-- Photo -->
      <div class="relative">
        <div class="overflow-hidden">
          <img src="/images/shane.webp" alt="Shane — SC Roofing Ltd"
            class="w-full object-cover" loading="lazy" />
        </div>
        <div class="bg-ink p-6 border-t-4 border-red">
          <p class="font-bebas text-white text-2xl leading-none mb-1" style="letter-spacing: 0.03em;">S.C Roofing Ltd</p>
          <p class="text-stone text-sm">Peasedown St John · Est. 2004</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ (also serves as AI-search extractable Q&A) -->
  <section class="bg-cream py-20 border-t border-ink/10">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-px bg-red block"></span>
        <p class="text-red text-xs font-bold uppercase tracking-[0.25em]">Frequently asked</p>
      </div>
      <h2 class="font-display text-ink mb-12 leading-none" style="font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: 0.02em;">
        Questions customers ask<br />before getting in touch.
      </h2>

      <div class="space-y-4">
        {[
          {
            q: "What accreditations does S.C Roofing hold?",
            a: `S.C Roofing Ltd is a Trade Member of the National Federation of Roofing Contractors (NFRC), is registered under the NFRC Competent Person Scheme for pitched roofing self-certification (Certificate ID 11921, valid 10 May 2026 to 09 May 2027), and is a Velux Certified Installer under the TrustMark Government Endorsed Quality scheme. We are also fully insured for Public Liability and Employer's Liability, and registered in England & Wales.`
          },
          {
            q: "What does the NFRC Competent Person Scheme mean for me as a customer?",
            a: `The NFRC CPS is the only roofing-specific scheme that allows roofers in England and Wales to self-certify that their roof refurbishment work meets Building Regulations 4 and 7. For you this means no separate Building Control inspection fee or delay on a qualifying re-roof, automatic issue of a Building Regulation Compliance Certificate, and eligibility for a 10-year Insurance-Backed Guarantee where required. Our CPS registration covers pitched roofing.`
          },
          {
            q: "How long has S.C Roofing been trading?",
            a: `Over 20 years — established in 2004. We are a small, privately owned company based at Delys, Eckweek Road, Peasedown St John, Bath, BA2 8EQ.`
          },
          {
            q: "What areas do you cover?",
            a: `Bath, Somerset and north Wiltshire within a 30-mile radius of our Peasedown St John depot. This includes Bath, Keynsham, Radstock, Midsomer Norton, Frome, Trowbridge, Shepton Mallet, Wells, Paulton, Norton St Philip and surrounding villages.`
          },
          {
            q: "Do you do free surveys?",
            a: `Yes. All surveys are free, written, and no-obligation. For most areas we can inspect within 24-48 hours of your enquiry, and you receive a fixed-price written quote before any work starts.`
          },
          {
            q: "Do you take on insurance work?",
            a: `Yes. We accept roofing work on insurance claims and provide written inspection reports suitable for insurers, loss adjusters, mortgage lenders and solicitors. We have over 20 years of experience with storm damage, leak investigations and pre-purchase roof surveys.`
          }
        ].map((item, i) => (
          <details class="group border border-ink/10 bg-white">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-ink font-bold text-lg leading-snug pr-4">{item.q}</h3>
              <span class="w-8 h-8 bg-red/10 group-open:bg-red flex items-center justify-center flex-shrink-0 transition-colors duration-200">
                <svg class="w-4 h-4 text-red group-open:text-white transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 -mt-2 text-ink/75 leading-relaxed text-base">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-ink py-20 border-t border-white/8">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-10 lg:divide-x divide-white/10">
        {trustStats.map(s => (
          <div class="lg:px-10 first:pl-0 last:pr-0">
            <p class="font-display text-white font-black leading-none mb-2" style="font-size: clamp(3rem, 7vw, 6rem);">
              {s.value}
            </p>
            <p class="text-stone text-xs font-medium uppercase tracking-[0.15em]">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-red py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-bebas text-white mb-6 leading-none" style="font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: 0.02em;">Ready to get started?</h2>
      <p class="text-white/70 mb-8">Free surveys, honest advice, no hard sell.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-white text-red font-black px-7 py-4 rounded-sm hover:bg-cream transition-colors text-lg">
          Get a Quote
        </a>
      </div>
    </div>
  </section>

</Layout>
