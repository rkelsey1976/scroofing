---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CANONICAL_URL } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "S.C Roofing Ltd — Roofing advice for Bath & Somerset homeowners",
  "url": `${CANONICAL_URL}/blog`,
  "publisher": {
    "@type": "Organization",
    "name": "S.C Roofing Ltd",
    "url": CANONICAL_URL
  }
};

const formatDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const SERVICE_LABELS: Record<string, string> = {
  'roof-repairs': 'Roof Repairs',
  'new-roofs': 'New Roofs',
  'flat-roofs': 'Flat Roofs',
  'chimney-repairs': 'Chimney Repairs',
  'leadwork': 'Leadwork',
  'guttering-fascias': 'Guttering & Fascias',
  'general': 'General advice'
};
---

<Layout
  title="Roofing Advice & Guides | SC Roofing Ltd"
  description="Practical roofing advice from a Bath roofer with 20+ years of experience. Roof repairs, flat roofs, chimneys, leadwork — written for homeowners."
  canonicalPath="/blog"
  schemas={[blogSchema]}
>

  <section class="relative bg-ink overflow-hidden" style="min-height: clamp(360px, 45vh, 520px);">
    <div class="absolute inset-0 bg-ink/85" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 w-full pt-36 pb-16">
      <div class="flex items-center gap-3 mb-8">
        <span class="w-8 h-px bg-red block"></span>
        <span class="text-stone text-xs font-medium tracking-[0.25em] uppercase">The Journal</span>
      </div>
      <h1 class="font-bebas text-white mb-6 leading-none" style="font-size: clamp(3.5rem, 8vw, 7rem); letter-spacing: 0.02em;">
        Roofing advice,<br /><span class="text-red">from the scaffold.</span>
      </h1>
      <p class="text-stone text-xl max-w-2xl leading-relaxed">
        Plain-English guides from 20+ years of fixing roofs across Bath, Somerset and north Wiltshire. No jargon, no sales pitch — just what we'd tell you if you were at our kitchen table.
      </p>
    </div>
  </section>

  <section class="bg-cream py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      {posts.length === 0 ? (
        <p class="text-ink/60 text-center py-20">No articles yet — check back soon.</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} class="group block bg-white border border-ink/8 hover:border-red/40 transition-colors">
              <div class="p-7">
                <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-ink/40 mb-4">
                  <span class="text-red font-bold">{SERVICE_LABELS[post.data.service]}</span>
                  <span>·</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
                <h2 class="font-display text-ink text-xl font-bold leading-snug mb-3 group-hover:text-red transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-ink/60 text-sm leading-relaxed mb-5 line-clamp-3">
                  {post.data.description}
                </p>
                <span class="text-red text-xs font-bold uppercase tracking-widest inline-flex items-center gap-2">
                  Read article
                  <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="bg-red py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-bebas text-white mb-4 leading-none" style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: 0.02em;">Got a roof problem we haven't covered?</h2>
      <p class="text-white/70 mb-8">Ask us directly — free, no obligation.</p>
      <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-white text-red font-black px-7 py-4 rounded-sm hover:bg-cream transition-colors text-lg">
        Get a Quote
      </a>
    </div>
  </section>

</Layout>